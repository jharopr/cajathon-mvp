# Solo backend. Nunca usar VITE_ para secretos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql://climashield:climashield_local@localhost:54322/climashield
# Migraciones: URL directa o session pooler, no transaction pooler.
DIRECT_URL=postgresql://climashield:climashield_local@localhost:54322/climashield
DATABASE_SSL=false
POSTGRES_PASSWORD=climashield_local
# Supabase PostgreSQL se conecta por DATABASE_URL detrás de NestJS.
# Estas variables quedan preparadas para futura Auth/Storage, no usadas todavía.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Generar con scripts/setup.ps1. Credencial local de coordinador.
DEMO_COORDINATOR_TOKEN=
DEMO_SEED=42
PORT=8081
# Procesador de eventos y alertas internas (no env?a mensajes externos).
EVENT_WORKER_ENABLED=true
EVENT_SOURCE_REFRESH_MINUTES=30
# Reproducci?n rotulada para demo si no hay aviso vigente.
DEMO_EVENTS_ENABLED=true
